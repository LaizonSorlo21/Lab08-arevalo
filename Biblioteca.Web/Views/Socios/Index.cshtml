@model IEnumerable<Socio>
@{
    ViewData["Title"] = "Socios";
}

<h1>Socios</h1>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @mensaje
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">Registrar socio</a>
</p>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>DNI</th>
            <th>Nombre</th>
            <th>Email</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var socio in Model)
        {
            <tr>
                <td>@socio.DNI</td>
                <td>@socio.Nombre</td>
                <td>@socio.Email</td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="3" class="text-center text-muted">No hay socios registrados.</td></tr>
        }
    </tbody>
</table>
