@model Libro
@{
    ViewData["Title"] = "Eliminar libro";
}

<h1>Eliminar libro</h1>

<div class="alert alert-warning">
    ¿Seguro que desea eliminar este libro? El libro dejará de mostrarse en el listado (eliminación lógica).
</div>

<dl class="row">
    <dt class="col-sm-3">Título</dt>
    <dd class="col-sm-9">@Model.Titulo</dd>
    <dt class="col-sm-3">ISBN</dt>
    <dd class="col-sm-9">@Model.ISBN</dd>
    <dt class="col-sm-3">Autor</dt>
    <dd class="col-sm-9">@Model.NombreAutor</dd>
    <dt class="col-sm-3">Ejemplares</dt>
    <dd class="col-sm-9">@Model.Ejemplares</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.LibroId" method="post">
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
</form>
