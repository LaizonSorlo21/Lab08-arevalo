@model Libro
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Nuevo libro";
    var autores = (SelectList)ViewData["Autores"]!;
}

<h1>Nuevo libro</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Titulo" class="form-label"></label>
                <input asp-for="Titulo" class="form-control" />
                <span asp-validation-for="Titulo" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ISBN" class="form-label"></label>
                <input asp-for="ISBN" class="form-control" />
                <span asp-validation-for="ISBN" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="AutorId" class="form-label"></label>
                <select asp-for="AutorId" asp-items="autores" class="form-select">
                    <option value="">-- Seleccione un autor --</option>
                </select>
                <span asp-validation-for="AutorId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Ejemplares" class="form-label"></label>
                <input asp-for="Ejemplares" type="number" min="0" class="form-control" />
                <span asp-validation-for="Ejemplares" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Guardar</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
